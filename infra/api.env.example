NODE_ENV=production
PORT=3333
# Required (min 32 chars). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
CORS_ORIGINS=https://langclips.example.com
ENABLE_BULL_BOARD=false
# Trust X-Forwarded-For only from the nginx on proxy-network, so rate limiting is
# per real client. Prefer the proxy-network subnet (docker network inspect
# proxy-network) — replace the example below; "1" (one hop) also works since the api publishes no ports.
# Unset = proxy headers ignored (every client shares the proxy's rate limit).
TRUST_PROXY=172.18.0.0/16

STORAGE_ENDPOINT=your-endpoint-here
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=your-access-key-id-here
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key-here
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_NAME=your-bucket-name

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-password
