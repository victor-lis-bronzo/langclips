NODE_ENV=production
PORT=3333
CORS_ORIGINS=https://langclips.example.com
ENABLE_BULL_BOARD=false

STORAGE_ENDPOINT=your-endpoint-here
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=your-access-key-id-here
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key-here
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_NAME=your-bucket-name

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-password
