# Storage/Cloudflare
STORAGE_ENDPOINT=your-endpoint-here
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=your-access-key-id-here
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key-here
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_NAME=your-bucket-name

# API Setup
PORT=3333
NODE_ENV=development
# Required in production (min 32 chars). Generate: openssl rand -hex 32
# In development/test an insecure built-in value is used when unset.
SESSION_SECRET=
# Optional. Trust X-Forwarded-For only from a reverse proxy (needed for per-client
# rate limiting behind a proxy). Unset/false = ignore proxy headers (default).
# Accepts a number of hops (e.g. 1) or a comma-separated list of IPs/CIDRs
# (e.g. 172.18.0.0/16, or loopback/linklocal/uniquelocal). "true" is rejected.
# TRUST_PROXY=

# Redis Variables
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
